{
  "manifest_version": 3,
  "name": "GetFullPage — Captura de Página Inteira & Editor Pro (Sem Limites)",
  "short_name": "GetFullPage",
  "version": "1.0.0",
  "description": "Capture páginas inteiras (Scroll inteligente, CDP instantâneo ou Container específico), exporte PDF com links clicáveis e edite sem limites ou paywall.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "GetFullPage — Capturar Página (Alt+Shift+P)",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "options_page": "src/options/options.html",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "downloads",
    "storage",
    "unlimitedStorage",
    "webNavigation",
    "debugger",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>",
    "file://*/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Abrir painel de captura rápida"
    },
    "capture-visible-quick": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Capturar área visível imediatamente"
    }
  }
}
